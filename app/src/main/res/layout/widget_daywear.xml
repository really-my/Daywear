<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent"
 android:orientation="vertical" android:gravity="center_vertical" android:padding="6dp" android:background="@drawable/widget_bg">
 <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
  android:orientation="horizontal" android:gravity="center_vertical" android:paddingLeft="10dp" android:paddingRight="10dp"
  android:background="@drawable/widget_weather_box">
  <TextView android:id="@+id/widget_current_icon" android:layout_width="wrap_content" android:layout_height="wrap_content"
   android:text="☀" android:textSize="29sp" android:includeFontPadding="false" android:textColor="#111111"/>
  <TextView android:id="@+id/widget_current_temp" android:layout_width="wrap_content" android:layout_height="wrap_content"
   android:layout_marginLeft="6dp" android:text="18°" android:textSize="27sp" android:textStyle="bold"
   android:includeFontPadding="false" android:textColor="#111111"/>
  <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
   android:gravity="end" android:orientation="vertical" android:layout_marginLeft="5dp">
   <TextView android:id="@+id/widget_city" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:gravity="end" android:text="현재 위치" android:textSize="12sp" android:textStyle="bold"
    android:textColor="#111111" android:singleLine="true" android:ellipsize="end"/>
   <TextView android:id="@+id/widget_condition" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:gravity="end" android:text="맑음" android:textSize="11sp" android:textColor="#666666" android:singleLine="true"/>
  </LinearLayout>
 </LinearLayout>
 <TextView android:id="@+id/widget_outfit" android:layout_width="match_parent" android:layout_height="wrap_content"
  android:layout_marginTop="5dp" android:gravity="center" android:text="가디건 · 긴팔 티셔츠"
  android:textSize="12sp" android:textStyle="bold" android:textColor="#222222"
  android:maxLines="2" android:ellipsize="end" android:includeFontPadding="false"/>
</LinearLayout>